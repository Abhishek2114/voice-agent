# voice-agent configuration. Copy to .env (setup-mac.sh does this) and adjust.
# Never commit .env. No value here is a real credential.

# --- server (bind to localhost only unless you know why you need otherwise)
VA_ENV=development
VA_HOST=127.0.0.1
VA_PORT=8000
VA_WEB_PORT=3000
# VA_DATA_DIR=./data
# Leave unset to auto-generate a per-install secret in data/.secret_key (0600).
# VA_SECRET_KEY=

# Set to true only when the dashboard is served over HTTPS (e.g. behind your own reverse proxy).
VA_COOKIE_SECURE=false
# JSON lists. Add your HTTPS hostname here if you expose customer links.
# VA_ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]"]
# VA_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- local AI (never cloud)
VA_OLLAMA_URL=http://127.0.0.1:11434
VA_DEFAULT_LLM_MODEL=qwen3:4b-instruct-2507-q4_K_M
# Models that Ollama proxies to a remote host (e.g. *:cloud) are refused unless this is true.
VA_ALLOW_REMOTE_LLM_MODELS=false
VA_WHISPER_SERVER_URL=http://127.0.0.1:8178
VA_WHISPER_MODEL=ggml-base.en-q5_1.bin
VA_PIPER_URL=http://127.0.0.1:5005
VA_DEFAULT_TTS_VOICE=en_GB-alba-medium
VA_VAD_KIND=silero

# --- capacity (16 GB Apple Silicon defaults)
VA_AI_CONCURRENCY=1
VA_MAX_VOICE_SESSIONS=2
VA_TELEPHONY_CONCURRENCY=4

# --- customer "talk to us" links (off by default)
VA_PUBLIC_CALLS_ENABLED=false

# --- real telephony (off by default; see docs/TELEPHONY.md and docs/COMPLIANCE.md)
VA_REAL_TELEPHONY_ENABLED=false
# Provider endpoints must be loopback/private addresses unless this is true.
VA_ALLOW_REMOTE_PROVIDER_HOSTS=false

# --- backups (optional) — used by scripts/backup.sh to encrypt archives
# VA_BACKUP_PASSPHRASE=
